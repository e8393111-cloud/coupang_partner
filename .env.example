# 쿠팡 파트너스 Open API 키 (https://partners.coupang.com → 내 정보 → 인증키 발급)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# Claude API 키 (카피 생성용, https://console.anthropic.com)
ANTHROPIC_API_KEY=

# 카피 생성 모델 (기본: claude-opus-4-8)
KUPAS_CAPTION_MODEL=claude-opus-4-8

# 클릭/전환 추적용 채널 태그 접두사 (subId 에 들어감, 영숫자만)
KUPAS_SUBID_PREFIX=kupas

# SQLite 저장 경로
KUPAS_DB_PATH=kupas.db

# (선택) 반자동 게시용 Make/Zapier 웹훅 URL — `kupas push` 가 게시 큐를 여기로 보냄
KUPAS_MAKE_WEBHOOK=
